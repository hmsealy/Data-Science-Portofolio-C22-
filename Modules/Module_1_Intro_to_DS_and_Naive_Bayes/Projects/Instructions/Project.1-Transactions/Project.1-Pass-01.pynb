    {
      "cell_type": "code",
      "source": [
        "# Display the correlation matrix\n",
        "\n",
        "#sns.heatmap(transaction_df_target_feature.corr(), annot=True),\n",
        "#code above display but cant see anything,\n",
        "\n",
        "plt.figure(figsize=(16, 12))\n",
        "sns.heatmap(transaction_df_target_feature.corr(),\n",
        "            annot=False,      # no numbers in the squares (too many to read)\n",
        "            cmap='coolwarm',  # blue = negative, red = positive\n",
        "            center=0,         # white = no correlation\n",
        "            vmin=-1, vmax=1)  # full correlation range\n",
        "plt.title('Correlation Matrix')\n",
        "plt.show()\n"
      ],
      "metadata": {
        "collapsed": true,
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 0
        },
        "id": "hoUTDjm9zdAX",
        "outputId": "57f8b425-44a4-41d0-e3ab-12acd3476cf5"
      },
      "id": "hoUTDjm9zdAX",
      "execution_count": 31,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 1600x1200 with 2 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Calculate a correlation matrix (features only)\n",
        "transaction_df_features_only = transaction_df_target_feature[feature_cols] #keep only the 50 feature columns(leave out target)\n",
        "feature_corr = transaction_df_features_only.corr()\n",
        "\n",
        "plt.figure(figsize=(16, 12))\n",
        "sns.heatmap(feature_corr,\n",
        "            annot=False,      # no numbers in the squares (too many to read)\n",
        "            cmap='coolwarm',  # blue = negative, red = positive\n",
        "            center=0,         # white/gray = no correlation\n",
        "            vmin=-1, vmax=1)  # full correlation range\n",
        "plt.title('Correlation Matrix - Features Only')\n",
        "plt.show()\n",
        "\n",
        "\n"
      ],
      "metadata": {
        "collapsed": true,
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 0
        },
        "id": "CiK41q7UJakI",
        "outputId": "32a0e67d-da05-4ef8-a514-748a7ea79e8d"
      },
      "id": "CiK41q7UJakI",
